# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# `.env` is gitignored - never commit it.

# --- Server ---------------------------------------------------------------
LOG_LEVEL=INFO
# Origins allowed to call this API from a browser (the Streamlit frontend).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Vector store ---------------------------------------------------------
# Produced by notebooks/rag_pipeline.ipynb. Relative paths resolve from backend/.
VECTOR_STORE_DIR=data/vector_store
COLLECTION_NAME=faa_handbooks
# Must match the model the notebook used to build the index.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ------------------------------------------------------------
# How many chunks to pull per question.
TOP_K=5
# Cosine similarity floor. Below this the assistant says "I don't know"
# instead of answering. Raise it if you see off-topic answers; lower it if
# the assistant refuses questions it should be able to answer.
MIN_SIMILARITY=0.25

# --- Local LLM (Ollama) ---------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
